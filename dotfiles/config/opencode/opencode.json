{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,

  "provider": {
    "github-copilot": {
      "options": {
        "baseURL": "https://copilot-api.sj.ghe.com"
      }
    }
  },
  "model": "github-copilot/gpt-5.3-codex",
  "small_model": "github-copilot/gpt-4.1",
  "default_agent": "plan",
  "lsp": {
    "jdtls": {
      "command": [
        "jdtls"
      ],
      "env": {
        "JAVA_TOOL_OPTIONS": "-javaagent:c:/Users/monir/.opencode_addon/lombok.jar"
      }
    }
  },
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "mcp": {
     "figma-mcp-dektop": {
       "type": "remote",
       "url": "http://127.0.0.1:3845/mcp",
       "enabled": false
     },
    "atlassian": {
      "type": "local",
      "command": [
        "docker", "run", "--rm", "-i",
        "-e", "JIRA_URL",
        "-e", "JIRA_USERNAME",
        "-e", "JIRA_API_TOKEN",
        "-e", "ENABLED_TOOLS",
        "ghcr.io/sooperset/mcp-atlassian:latest"
      ],
      "environment": {
        "JIRA_URL": "{env:JIRA_URL}",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
        "ENABLED_TOOLS": "jira_get_issue,jira_search"
      },
      "enabled": true
    }
  },
  "instructions": [
    "skills/react-typescript/SKILL.md",
  ]
}
